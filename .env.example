# ==============================================================
# APPISTRY — THE HIDDEN KEY
# Environment Configuration Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real credentials.
# ==============================================================

# Database
DATABASE_URL="file:./dev.db"

# Authentication Secrets (generate with: openssl rand -hex 64)
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS"
SESSION_SECRET="REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET"

# Admin Credentials (Seed Only - change after first login)
SEED_ADMIN_EMAIL="admin@appistry.dev"
SEED_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
SEED_ADMIN_NAME="APPISTRY Admin"

# Event Answer (Server-Side Only -- NEVER expose to client)
# NEVER prefix with NEXT_PUBLIC_
EVENT_SECRET_KEYWORD="REPLACE_WITH_ACTUAL_SECRET_KEYWORD"

# Email Provider (Gmail SMTP / Custom)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="organizer@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="APPISTRY <no-reply@appistry.com>"
ORGANIZER_NOTIFICATION_EMAIL="organizer@gmail.com"

# Global Rate Limiting (20 Submissions per minute)
SUBMISSION_RATE_LIMIT_WINDOW_MS="60000"
SUBMISSION_RATE_LIMIT_MAX="20"

# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="APPISTRY -- The Hidden Key"

# Cookie settings
SESSION_COOKIE_NAME="appistry_session"
SESSION_DURATION_HOURS="24"
